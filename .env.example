# Copiez ce fichier en .env puis remplacez chaque valeur "change-me".
# Générer un secret :  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Ports exposés sur la machine ---
WEB_PORT=8080
N8N_PORT=5678
APP_TIMEZONE=Europe/Paris

# --- Base de données (PostgreSQL) ---
POSTGRES_PASSWORD=change-me

# --- Connexion à l'interface web ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-at-least-16-chars
# true si le site est servi en HTTPS
COOKIE_SECURE=false

# --- Échanges backend <-> n8n ---
# Secret partagé (en-tête X-Webhook-Secret) + clé de la signature HMAC (X-Signature)
WEBHOOK_SECRET=change-me-at-least-16-chars
WEBHOOK_HMAC_REQUIRED=true
# n8n : chiffre les identifiants stockés dans n8n
N8N_ENCRYPTION_KEY=change-me

# --- Envoi des réponses ---
# mock : envoi simulé (démo sans Gmail) | n8n : envoi réel via le workflow Gmail
REPLY_TRANSPORT=mock

# --- IA (Groq, gratuit : https://console.groq.com/keys) ---
# Vide : brouillons et résumé par modèles automatiques, classification n8n en pause
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
