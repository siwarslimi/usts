        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $env.GROQ_MODEL || 'qwen/qwen3.8-27b', temperature: 0.2, response_format: { type: 'json_object' }, max_tokens: 300, messages: [{ role: 'system', content: \"Tu classes des e-mails professionnels reçus par une petite entreprise française. Réponds UNIQUEMENT avec un objet JSON valide, sans aucun texte autour, exactement de la forme {\\\"category\\\": \\\"...\\\", \\\"priority\\\": 1, \\\"summary\\\": \\\"...\\\", \\\"action\\\": \\\"...\\\"}. category : une valeur parmi \\\"client\\\", \\\"facture\\\", \\\"rendez-vous\\\", \\\"newsletter\\\", \\\"spam probable\\\", \\\"autre\\\". priority : entier 1 (urgent), 2 (normal) ou 3 (faible). summary : une seule phrase en français résumant l'e-mail. action : l'action attendue de l'utilisateur, en quelques mots.\" + ' ATTENTION : ta réponse précédente était invalide (' + ($json.error || 'format') + '). Respecte strictement le format JSON demandé.' }, { role: 'user', content: 'Expéditeur : ' + $('Loop Over Items').item.json.from_email + '\\nObjet : ' + $('Loop Over Items').item.json.subject + '\\n\\n' + $('Loop Over Items').item.json.text }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "b5c85132-071d-58c1-ae5a-5cbba9841b82",
      "name": "Signer : essai 2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        -160
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst sign = (payload) => 'sha256=' + crypto.createHmac('sha256', $env.WEBHOOK_SECRET).update(payload).digest('hex');\nconst email = $('Loop Over Items').item.json;\nconst raw = ($json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content) || '';\nconst payload = JSON.stringify({ email_id: email.id, raw_output: raw, attempt: 2 });\nreturn { json: { payload, signature: sign(payload) } };",
        "mode": "runOnceForEachItem"
      }
    },
